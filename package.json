{
  "name": "garage-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "staff:create": "tsx scripts/create-staff-user.ts",
    "garage:profile": "tsx scripts/set-garage-profile.ts",
    "postinstall": "prisma generate",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "db:guard": "tsx scripts/db-guard.ts migrate-deploy",
    "db:dry-run": "tsx scripts/db-dry-run.ts",
    "db:verify-ci": "tsx scripts/verify-ci-target.ts",
    "db:ci-cleanup": "tsx scripts/ci-cleanup.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "libphonenumber-js": "1.13.17",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pino": "10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@neon/config": "1.14.6",
    "@neon/env": "2.1.9",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.12 <23 || >=24"
  }
}
