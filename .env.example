# ─────────────────────────────────────────────────────────────────────────────
# Garage Management System — environment template
# Copy to `.env` (read by Next.js and Prisma) and fill in values.
# NEVER commit real values. `.env*` files other than this one are git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Neon PostgreSQL — use the DEVELOPMENT branch for local work, never production.
# Populate with: neon checkout development && neon env pull --branch development
# DATABASE_URL:          pooled connection string (host contains "-pooler") — used by the app.
# DATABASE_URL_UNPOOLED: direct connection string — used by Prisma migrations.
# DIRECT_URL:            optional legacy name for the direct string (takes precedence if set).
# NEON_BRANCH:           branch name; migrations/staff:create refuse production/prod/main.
# Leave the URLs empty to run the app without a database (health check reports "unconfigured").
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DIRECT_URL=
NEON_BRANCH=
NEON_BRANCH_ID=
# Owner-approved override for the production-branch guard. Leave unset.
# ALLOW_PRODUCTION_DB_WRITES=

# Auth.js (staff sign-in). Generate a secret with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Public base URL in deployed environments, e.g. https://gms.example.com
# AUTH_URL=
# Staff sign-in rate limits per 15 minutes (defaults 10 per email, 50 per client IP).
# AUTH_RATE_LIMIT_PER_EMAIL=10
# AUTH_RATE_LIMIT_PER_IP=50
# Set to true only behind a trusted reverse proxy / platform that sets the Host header.
# AUTH_TRUST_HOST=false
