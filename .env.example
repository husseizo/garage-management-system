# ─────────────────────────────────────────────────────────────────────────────
# Garage Management System — environment template
# Copy to `.env` (read by Next.js and Prisma) and fill in values.
# NEVER commit real values. `.env*` files other than this one are git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Neon PostgreSQL (use the DEVELOPMENT branch for local work).
# DATABASE_URL: pooled connection string (host contains "-pooler") — used by the app.
# DIRECT_URL:   direct connection string — used by Prisma migrations.
# Leave empty to run the app without a database (health check reports "unconfigured").
DATABASE_URL=
DIRECT_URL=

# Auth.js (staff sign-in). Generate a secret with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Public base URL in deployed environments, e.g. https://gms.example.com
# AUTH_URL=
# Set to true only behind a trusted reverse proxy / platform that sets the Host header.
# AUTH_TRUST_HOST=false
